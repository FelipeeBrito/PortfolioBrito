---
import '../styles/global.css'
import Robot from '../components/Robot.tsx'
import { profile } from '../data/profile'

interface Props {
  title: string
  description: string
  /** Página atual (destaca o link no menu e define a fala do robô). */
  page: 'inicio' | 'projetos' | 'sobre' | 'contato'
}
const { title, description, page } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const nav = [
  ['inicio', 'Início', `${base}/`],
  ['projetos', 'Projetos', `${base}/projetos/`],
  ['sobre', 'Sobre', `${base}/sobre/`],
  ['contato', 'Contato', `${base}/contato/`],
] as const
const year = new Date().getFullYear()
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#04060f" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${base}/robot/acenando.webp`} />
    <link rel="icon" type="image/webp" href={`${base}/robot/acenando.webp`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="antialiased" data-page={page}>
    <!-- navegação (pílula de vidro) -->
    <header class="fixed inset-x-0 top-3 z-[45] flex justify-center px-3 sm:top-4">
      <nav class="glass flex w-full max-w-3xl items-center justify-between gap-2 rounded-full py-1.5 pl-2 pr-1.5 sm:py-2 sm:pl-4 sm:pr-2" aria-label="Principal">
        <a href={`${base}/`} class="flex shrink-0 items-center gap-2 text-sm font-semibold text-white" aria-label="Início">
          <span class="grid h-8 w-8 place-items-center rounded-full border border-lab-cyan/60 font-mono text-[10px] text-lab-cyan shadow-[0_0_12px_-2px_rgba(40,225,255,0.7)]">FB</span>
          <span class="hidden md:inline">{profile.name}</span>
        </a>
        <ul class="flex items-center text-[13px]">
          {nav.map(([id, label, href]) => (
            <li>
              <a
                href={href}
                aria-current={page === id ? 'page' : undefined}
                class:list={[
                  'block rounded-full px-2.5 py-1.5 transition sm:px-3.5',
                  page === id ? 'bg-lab-cyan/10 text-white shadow-[inset_0_0_0_1px_rgba(40,225,255,0.4)]' : 'text-lab-muted hover:bg-white/5 hover:text-white',
                ]}
              >{label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>

    <slot />

    {page !== 'inicio' && (
      <footer class="border-t border-white/5 px-5 pb-36 pt-8 text-center font-mono text-xs text-lab-muted sm:pb-10">
        © {year} {profile.name} · feito com Astro + Claude
      </footer>
    )}

    <Robot client:idle page={page} />

    <script>
      // animação de "aparecer ao rolar"
      const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add('in'), io.unobserve(e.target))), { threshold: 0.1 })
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el))
    </script>
  </body>
</html>
