---
import Base from '../layouts/Base.astro'
import { profile } from '../data/profile'
import { skills } from '../data/skills'
import { conversa } from '../data/conversa'
import { fetchGithub, renderCards, renderProfile } from '../lib/github'

// "Foto" dos dados do GitHub na hora de gerar o site. No navegador, os dados são buscados de novo.
const gh = await fetchGithub(profile.github)
const site = { name: profile.name, role: profile.role, github: profile.github }
// enquanto o e-mail e o LinkedIn de src/data/profile.ts forem os de exemplo, o site não mostra canais falsos
const temEmail = !profile.email.includes('exemplo')
const temLinkedin = profile.linkedin.includes('/in/')
const falas = temEmail ? conversa : { ...conversa, secoes: { ...conversa.secoes, contato: conversa.secoes.contatoSemEmail } }
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const year = new Date().getFullYear()
const nav = [
  ['projetos', 'Projetos'],
  ['sobre', 'Sobre'],
  ['contato', 'Contato'],
]
---

<Base title={`${profile.name} · Portfólio`} description={profile.headline}>
  <!-- partículas das transições e a coruja 3D (cada uma no seu canvas) -->
  <canvas id="fx" class="pointer-events-none fixed inset-0 z-30" aria-hidden="true"></canvas>
  <canvas id="owl" class="pointer-events-none fixed left-0 top-0 z-30 origin-top-left opacity-0 transition-opacity duration-1000" aria-hidden="true"></canvas>

  <!-- topo -->
  <header class="fixed inset-x-0 top-0 z-40 flex items-center justify-between gap-3 px-4 py-4 sm:px-8 sm:py-6">
    <a href="#inicio" data-go="home" class="shrink-0 whitespace-nowrap font-mono text-xs tracking-[0.2em] text-muted transition hover:text-white" aria-label="Voltar ao início">
      OWLLSKULL<span class="hidden sm:inline"> <span class="text-cyan">·</span> FELIPE BRITO</span>
    </a>
    <nav id="nav" hidden class="flex items-center gap-1 sm:gap-2 lg:mr-auto lg:ml-8" aria-label="Seções">
      {nav.map(([id, label]) => (
        <a href={`#${id}`} data-go={id} class="chip chip-sm">{label}</a>
      ))}
    </nav>
    <a id="skip" href="#tudo" data-go="tudo" class="chip chip-sm">ver tudo sem conversa →</a>
  </header>

  <main>
    <!-- ===== INÍCIO: a IA conversa ===== -->
    <section id="home" class="view on shown min-h-svh flex-col items-center justify-center px-5 pb-10 pt-20 text-center">
      <h1 class="sr-only">{profile.name} — Portfólio de projetos com IA</h1>
      <div id="robot-stage" class="aspect-square h-[min(42svh,380px)] cursor-pointer sm:h-[min(52svh,500px)]" aria-hidden="true"></div>
      <div class="mt-4 w-full max-w-3xl sm:mt-6">
        <p id="talk" class="min-h-[3.2em] text-[clamp(1.25rem,3.4vw,1.9rem)] font-medium leading-snug text-white" aria-live="polite"></p>
        <div id="chips" class="mt-6 flex flex-wrap justify-center gap-2.5 opacity-0 transition-opacity duration-500 sm:gap-3">
          {conversa.opcoes.map((o) => (
            <a href={`#${o.id}`} data-go={o.id} class="chip">{o.label}</a>
          ))}
        </div>
      </div>
      <noscript><p class="mt-8 text-muted">Ative o JavaScript para conversar com a IA — ou veja o conteúdo abaixo.</p></noscript>
    </section>

    <div id="sections">
      <!-- ===== PROJETOS ===== -->
      <section id="projetos" class="view mx-auto max-w-6xl px-5 pb-36 pt-28 sm:px-8 lg:pb-24 lg:pt-36">
        <p class="eyebrow mb-3">Projetos</p>
        <h2 data-p="text" class="text-[clamp(2.6rem,7vw,4.25rem)] font-semibold leading-none tracking-tight text-white">Projetos</h2>
        <p class="mt-4 max-w-xl text-muted">Os mais recentes, direto do meu GitHub — criados com inteligência artificial, da ideia ao código publicado.</p>

        <!-- cartão de perfil do GitHub (atualizado no navegador) -->
        <div id="gh-profile" class="mt-8" set:html={renderProfile(gh?.profile ?? null, site, gh?.projects[0]?.updatedAt)} />

        <div id="filtro" class="mt-6 hidden flex-wrap items-center gap-2 font-mono text-xs text-muted">
          filtro: <b id="filtro-nome" class="text-cyan"></b>
          <button type="button" data-filter="" class="chip chip-sm">limpar ✕</button>
        </div>
        <div id="gh-grid" class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-7" set:html={renderCards(gh?.projects ?? [])} />
        <p class="mt-10 text-center">
          <a href={`https://github.com/${profile.github}?tab=repositories`} target="_blank" rel="noopener" class="chip">Ver todos os projetos no GitHub ↗</a>
        </p>
      </section>

      <!-- ===== SOBRE ===== -->
      <section id="sobre" class="view mx-auto max-w-6xl px-5 pb-36 pt-28 sm:px-8 lg:pb-24 lg:pt-36">
        <p class="eyebrow mb-3">Sobre</p>
        <h2 data-p="text" class="text-[clamp(2.6rem,7vw,4.25rem)] font-semibold leading-none tracking-tight text-white">{profile.name}</h2>
        <p class="mt-4 text-lg text-cyan">{profile.role}</p>
        <div data-p="box" class="card mt-10 p-6 sm:p-9">
          <div class="max-w-3xl space-y-4 text-base leading-relaxed text-muted sm:text-lg">
            {profile.about.map((t) => <p>{t}</p>)}
          </div>
        </div>
        <h3 class="mt-16 text-2xl font-semibold text-white">Habilidades</h3>
        <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {skills.map((g) => (
            <div data-p="box" class="card p-6">
              <h4 class="eyebrow mb-5">{g.group}</h4>
              <ul class="space-y-5">
                {g.items.map((s) => (
                  <li>
                    <div class="mb-2 flex justify-between gap-3 text-sm"><span class="text-white">{s.name}</span><span class="font-mono text-xs text-muted">{s.level}%</span></div>
                    <div class="meter"><span style={`width:${s.level}%`}></span></div>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- ===== CONTATO ===== -->
      <section id="contato" class="view mx-auto max-w-6xl px-5 pb-36 pt-28 sm:px-8 lg:pb-24 lg:pt-36">
        <p class="eyebrow mb-3">Contato</p>
        <h2 data-p="text" class="text-[clamp(2.6rem,7vw,4.25rem)] font-semibold leading-none tracking-tight text-white">Vamos conversar?</h2>
        <div class="mt-10 grid gap-6 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
          <form id="contact" hidden={!temEmail} data-p={temEmail ? 'box' : undefined} class="card space-y-5 p-6 sm:p-8">
            <div class="grid gap-5 sm:grid-cols-2">
              <label class="block text-sm text-muted">Nome<input required name="nome" autocomplete="name" class="field" /></label>
              <label class="block text-sm text-muted">E-mail<input required type="email" name="email" autocomplete="email" class="field" /></label>
            </div>
            <label class="block text-sm text-muted">Mensagem<textarea required name="mensagem" rows="5" class="field"></textarea></label>
            <button type="submit" class="chip border-cyan/60 text-white">Enviar mensagem →</button>
          </form>
          {!temEmail && (
            <div data-p="box" class="card flex flex-col items-start gap-4 p-6 sm:p-8">
              <p class="text-lg text-white">O formulário de mensagens está sendo ligado.</p>
              <p class="text-muted">Por enquanto, o caminho mais rápido é o GitHub.</p>
              <a href={`https://github.com/${profile.github}`} target="_blank" rel="noopener" class="chip border-cyan/60 text-white">Abrir meu GitHub ↗</a>
            </div>
          )}
          <div data-p="box" class="card flex flex-col gap-3 p-6 text-sm sm:p-8">
            <p class="eyebrow mb-1">Canais diretos</p>
            <a href={`https://github.com/${profile.github}`} target="_blank" rel="noopener" class="chip justify-between">GitHub <span class="text-cyan">↗</span></a>
            {temLinkedin && <a href={profile.linkedin} target="_blank" rel="noopener" class="chip justify-between">LinkedIn <span class="text-cyan">↗</span></a>}
            {temEmail && <a href={`mailto:${profile.email}`} class="chip justify-between">E-mail <span class="text-cyan">↗</span></a>}
          </div>
        </div>
      </section>

      <footer class="view px-5 pb-32 pt-4 text-center font-mono text-xs text-muted lg:pb-10" data-footer>
        © {year} {profile.name} · feito com Astro + Claude
      </footer>
    </div>
  </main>

  <!-- coruja pequena no canto (o desenho é feito no canvas; isto é a área clicável) -->
  <button id="robot-mini" hidden type="button" class="fixed bottom-3 right-2 z-[45] aspect-square h-[88px] cursor-pointer rounded-full outline-none focus-visible:ring-2 focus-visible:ring-cyan lg:bottom-auto lg:right-5 lg:top-4 lg:h-[112px]" aria-label="Voltar a conversar com a IA" title="Voltar a conversar"></button>

  <!-- balão da IA -->
  <div id="bubble" hidden class="fixed inset-x-2.5 bottom-[106px] z-50 rounded-2xl border border-cyan/35 bg-[#0c1430]/95 px-4 py-3 text-sm text-ink shadow-[0_0_30px_-10px_rgba(40,225,255,0.7)] backdrop-blur lg:inset-x-auto lg:bottom-auto lg:right-[150px] lg:top-6 lg:w-[330px]" role="status">
    <p class="mb-1 font-mono text-[10px] tracking-[0.18em] text-cyan">● OWLLSKULL</p>
    <p id="bubble-text" class="leading-relaxed"></p>
    <div id="bubble-chips" class="mt-2.5 flex flex-wrap gap-1.5 empty:hidden"></div>
  </div>

  <!-- forma usada na animação de "mensagem enviada" -->
  <div id="sent-shape" class="pointer-events-none invisible fixed inset-0 z-0 flex items-center justify-center" aria-hidden="true">
    <span data-p="text" class="text-[clamp(2.5rem,9vw,6rem)] font-semibold text-white">Enviado ✓</span>
  </div>

  <script type="application/json" id="conversa" set:html={JSON.stringify({ ...falas, email: profile.email, base, site, gh }).replace(/</g, '\\u003c')} />
  <script>
    import { initApp } from '../scripts/app'
    initApp()
  </script>
</Base>
