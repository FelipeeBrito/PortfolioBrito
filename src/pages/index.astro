---
import Base from '../layouts/Base.astro'
import WovenField from '../components/WovenField.tsx'
import { profile } from '../data/profile'
import { loadProjects } from '../lib/projects'

const projects = await loadProjects()
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<Base title={`${profile.name} · Portfólio`} description={profile.headline} page="inicio">
  <main id="topo">
    <!-- Tela inicial: só o robô e a apresentação. O conteúdo fica nas outras páginas. -->
    <section class="relative flex min-h-svh items-center overflow-hidden">
      <WovenField client:idle />
      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-b from-transparent to-lab-bg"></div>

      <div class="relative mx-auto grid w-full max-w-7xl items-center gap-4 px-5 pb-10 pt-24 sm:px-8 lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)] lg:gap-10 xl:grid-cols-[minmax(0,30rem)_minmax(0,1fr)] lg:pb-16 lg:pt-20">
        <div class="text-center lg:text-left">
          <p class="eyebrow mb-5 inline-flex items-center gap-2"><span class="led"></span> Portfólio · Projetos com IA</p>
          <h1 class="font-display text-[clamp(3rem,11vw,5rem)] xl:text-[6.25rem] leading-[0.95] text-white">
            {profile.name.split(' ')[0]}{' '}<br class="hidden lg:block" />
            <span class="bg-gradient-to-r from-lab-cyan via-[#7ab8ff] to-lab-violet bg-clip-text text-transparent">{profile.name.split(' ').slice(1).join(' ')}</span>
          </h1>
          <p class="mt-5 text-base text-white sm:text-lg">{profile.role}</p>
          <p class="mx-auto mt-2 max-w-[42ch] text-sm leading-relaxed text-lab-muted sm:text-base lg:mx-0">{profile.headline}</p>
          <div class="mt-8 flex flex-wrap justify-center gap-3 lg:justify-start">
            <button type="button" class="btn btn-primary" data-robot-action="menu">Vamos lá? <span aria-hidden="true">›</span></button>
            <button type="button" class="btn btn-ghost" data-robot-action="tour">▶ Fazer o tour</button>
          </div>
          <p class="mt-8 font-mono text-xs text-lab-muted">
            <a href={`${base}/projetos/`} class="hover:text-white"><span class="text-lab-cyan">{projects.length}</span> projeto{projects.length > 1 ? 's publicados' : ' publicado'} · criados com <span class="text-white">Claude</span> →</a>
          </p>
        </div>

        <!-- o robô é posicionado sobre este espaço (ver Robot.tsx); à direita sobra espaço para o menu dele -->
        <div id="robot-anchor" class="mx-auto aspect-square w-[min(68vw,260px)] sm:w-[300px] lg:mx-0 lg:w-[300px] xl:w-[380px]" aria-hidden="true"></div>
      </div>
    </section>
  </main>
</Base>
