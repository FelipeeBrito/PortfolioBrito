---
import Base from '../../layouts/Base.astro'
import { profile } from '../../data/profile'
import { loadProjects, thumb } from '../../lib/projects'

const projects = await loadProjects()
---

<Base title={`Projetos · ${profile.name}`} description="Projetos criados com inteligência artificial." page="projetos">
  <main class="mx-auto max-w-6xl px-5 pb-16 pt-32 sm:px-8 sm:pt-36">
    <p class="eyebrow mb-3">Projetos</p>
    <h1 class="font-display text-[clamp(2.6rem,7vw,4.5rem)] leading-none text-white">Meus projetos</h1>
    <p class="mt-4 max-w-xl text-lab-muted">Tudo aqui foi criado com o apoio de inteligência artificial — da ideia ao código publicado. Passe o mouse sobre um projeto e o robô apresenta os detalhes.</p>

    <div id="filtro" class="mt-6 hidden flex-wrap items-center gap-3 font-mono text-xs text-lab-muted">
      filtro: <b id="filtro-nome" class="text-lab-cyan"></b>
      <button type="button" data-robot-action="clear-filter" class="rounded-full border border-white/10 px-3 py-1 hover:border-lab-cyan hover:text-white">limpar ✕</button>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 lg:gap-8">
      {projects.map((p, i) => (
        <article
          class="glass card reveal group flex flex-col overflow-hidden"
          data-robot-scan
          data-name={p.name}
          data-exp={`Projeto ${String(i + 1).padStart(2, '0')}`}
          data-tags={p.tags.join('|').toLowerCase()}
          data-lang={p.language ?? p.tags[0] ?? ''}
          data-updated={p.updatedAt ?? ''}
          data-stars={p.stars ?? ''}
        >
          <span class="scanline" aria-hidden="true"></span>
          <div class="relative aspect-[16/9] overflow-hidden border-b border-white/5 bg-gradient-to-br from-lab-navy via-[#1b1f5c] to-[#3a1d6e]">
            {thumb(p) && <img src={thumb(p)} alt="" loading="lazy" class="h-full w-full object-cover opacity-80 transition duration-500 group-hover:scale-105 group-hover:opacity-100" onerror="this.remove()" />}
            <span class="absolute left-3 top-3 flex items-center gap-1.5 rounded-full bg-black/50 px-2.5 py-1 font-mono text-[10px] uppercase text-white backdrop-blur"><span class="led"></span>{p.status ?? 'online'}</span>
          </div>
          <div class="flex flex-1 flex-col p-6">
            <h2 class="text-lg font-semibold text-white">{p.name}</h2>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-lab-muted">{p.description}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              {p.tags.map((t) => <span class="rounded-full border border-lab-cyan/25 bg-lab-cyan/5 px-2.5 py-0.5 text-[11px] text-lab-cyan">{t}</span>)}
            </div>
            <div class="mt-6 flex flex-wrap gap-2">
              {p.url && <a href={p.url} target="_blank" rel="noopener" class="btn btn-primary !px-4 !py-2 text-sm">Ver projeto ›</a>}
              {p.repo && <a href={p.repo} target="_blank" rel="noopener" class="btn btn-ghost !px-4 !py-2 text-sm">Código</a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </main>
</Base>
