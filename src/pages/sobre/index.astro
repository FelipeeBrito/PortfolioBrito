---
import Base from '../../layouts/Base.astro'
import { profile } from '../../data/profile'
import { skills } from '../../data/skills'
---

<Base title={`Sobre · ${profile.name}`} description={profile.headline} page="sobre">
  <main class="mx-auto max-w-6xl px-5 pb-16 pt-32 sm:px-8 sm:pt-36">
    <p class="eyebrow mb-3">Sobre mim</p>
    <h1 class="font-display text-[clamp(2.6rem,7vw,4.5rem)] leading-none text-white">Quem está por trás</h1>

    <div class="glass card reveal mt-12 grid items-center gap-8 p-7 sm:p-10 md:grid-cols-[auto_minmax(0,1fr)]">
      <div class="mx-auto grid h-28 w-28 place-items-center rounded-3xl border border-lab-cyan/40 bg-lab-navy/40 font-display text-5xl text-lab-cyan shadow-[0_0_40px_-10px_rgba(40,225,255,0.6)] md:mx-0">FB</div>
      <div>
        <h2 class="text-xl font-semibold text-white">{profile.name}</h2>
        <p class="mt-1 text-lab-cyan">{profile.role}</p>
        <div class="mt-4 space-y-3 leading-relaxed text-lab-muted">
          {profile.about.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>

    <section id="habilidades" class="mt-24">
      <p class="eyebrow mb-3">Skills</p>
      <h2 class="font-display text-[clamp(2.2rem,5vw,3.25rem)] leading-none text-white">Habilidades</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-8">
        {skills.map((g) => (
          <div class="glass card reveal p-7">
            <h3 class="eyebrow mb-6">{g.group}</h3>
            <ul class="space-y-6">
              {g.items.map((s) => (
                <li>
                  <div class="mb-2 flex justify-between gap-3 text-sm"><span class="text-white">{s.name}</span><span class="font-mono text-xs text-lab-muted">{s.level}%</span></div>
                  <div class="meter"><span style={`width:${s.level}%`}></span></div>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </main>
</Base>
